{
  "name": "location-demo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "server:dev": "tsx server/index.ts",
    "server:check": "tsc -p server/tsconfig.json --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "validate": "pnpm typecheck && pnpm server:check && pnpm lint && pnpm test && pnpm exec expo config --type public --json"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@tanstack/react-query": "^5.101.4",
    "expo": "^57.0.12",
    "expo-clipboard": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-location": "~57.0.9",
    "expo-network": "~57.0.1",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-maps": "1.29.0",
    "react-native-safe-area-context": "~5.8.1",
    "react-native-screens": "~4.27.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.21",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "19.0.0",
    "babel-preset-expo": "57.0.6",
    "@hono/node-server": "^1.19.17",
    "eslint": "8.57.1",
    "eslint-config-expo": "57.0.1",
    "hono": "^4.13.11",
    "jest": "29.7.0",
    "jest-expo": "57.0.3",
    "react-test-renderer": "19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}

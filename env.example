# Mobile runtime configuration. The proxy URL is bundled into the app.
# Use a LAN-reachable address when testing on a physical device.
EXPO_PUBLIC_PLACES_API_URL=http://localhost:8787

# Optional application-restricted Maps SDK keys for native map rendering.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=

# Server-only configuration. Never put this in an EXPO_PUBLIC_ variable.
GOOGLE_PLACES_API_KEY=
